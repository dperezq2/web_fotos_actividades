# Copiar como .env (junto a docker-compose.yml) y cambiar las contraseñas.
# El archivo .env no se sube al repositorio.

MYSQL_ROOT_PASSWORD=cambiar_root_password
MYSQL_DATABASE=sorteos_pb
MYSQL_USER=sorteos_app
MYSQL_PASSWORD=cambiar_app_password

# Clave para firmar las sesiones (login). Generar una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar_por_una_clave_larga_y_aleatoria

# Dominio público y correo para avisos de Let's Encrypt (vencimiento del certificado)
DOMAIN=actividades.paloblancofreshfoods.com.gt
CERTBOT_EMAIL=admin@paloblancofreshfoods.com.gt

# Puerto en el host para conectarse a MySQL (Workbench, DBeaver...): 127.0.0.1:3307
# MYSQL_HOST_PORT=3307
